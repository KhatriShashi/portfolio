---
import SiteLayout from '../../layouts/SiteLayout.astro';
import ProjectArtwork from '../../components/ProjectArtwork.astro';
import { projects } from '../../data/projects';
export function getStaticPaths() { return projects.map((project) => ({ params: { slug: project.slug }, props: { project } })); }
const { project } = Astro.props;
const index = projects.findIndex((item) => item.slug === project.slug);
const nextProject = projects[(index + 1) % projects.length];
---
<SiteLayout title={project.title} description={project.summary} active="work">
  <article class="case-study">
    <div class="case-topline wrap"><a class="text-link" href="/work/">← ALL WORK</a><div class="case-top-actions"><span class="mono">CASE STUDY {project.number} / 0{projects.length}</span></div></div>
    <header class="case-header wrap"><p class="eyebrow">{project.category.toUpperCase()}</p><h1>{project.title}</h1><p class="case-deck">{project.summary}</p><div class="case-meta"><div><span class="mono">CLIENT / PROJECT</span><strong>{project.client}</strong></div><div><span class="mono">MY CONTRIBUTION</span><strong>{project.role}</strong></div><div><span class="mono">FOCUS</span><strong>{project.services.join(' · ')}</strong></div><div><span class="mono">STACK</span><strong>{project.stack.join(' · ')}</strong></div></div></header>
    <ProjectArtwork project={project} hero={true} />
    <div class="client-site-links wrap"><span class="mono">{project.links.length > 1 ? 'RELATED STORES' : 'CLIENT WEBSITE'}</span><div>{project.links.map((link) => <a href={link.href} target="_blank" rel="noreferrer">{link.label} ↗</a>)}</div></div>
    <section class="case-overview wrap"><div><p class="eyebrow">THE CHALLENGE & APPROACH</p><h2>Good work<br />starts with a<br /><em>good question.</em></h2></div><div class="case-overview-copy"><p>{project.challenge}</p><p>{project.approach}</p><div class="service-tags">{project.services.map((service) => <span>{service}</span>)}</div></div></section>
    {project.sections.map((section, i) => <section class={`case-section wrap ${i % 2 ? 'case-section-reverse' : ''}`}><div class="case-section-copy"><p class="eyebrow">0{i + 1} / THE PROCESS</p><h2>{section.title}</h2><p>{section.body}</p></div><div class={`case-visual ${section.visual}`}><div class="visual-composition"><span class="visual-small-label">{project.client.toUpperCase()}</span><div class="visual-graphic"><span></span><span></span><span></span><span></span></div><strong>{project.number}<i> / {section.title.toUpperCase()}</i></strong></div><p class="visual-caption">{section.caption}</p></div></section>)}
    <section class="case-outcome"><div class="wrap outcome-grid"><div><p class="eyebrow">THE OUTCOME</p><h2>Made to move<br />things <em>forward.</em></h2></div><div><p>{project.outcome}</p><div class="outcome-result">{project.result}</div></div></div></section>
    <nav class="next-project wrap" aria-label="Next project"><span class="mono">NEXT UP · {nextProject.number} / {nextProject.category.toUpperCase()}</span><a href={`/work/${nextProject.slug}/`}>{nextProject.title}<span>↗</span></a><a class="text-link" href="/work/">BACK TO ALL WORK</a></nav>
  </article>
</SiteLayout>
