---
import SiteLayout from '../layouts/SiteLayout.astro';
import { site } from '../data/site';
import { projects } from '../data/projects';
---
<SiteLayout title="Résumé" active="resume">
  <section class="page-intro wrap"><p class="eyebrow">03 / EXPERIENCE & SKILLS</p><div class="page-intro-row"><h1>Backend<br />systems.<br /><em>Useful products.</em></h1><div><p>{site.summary}</p><a class="text-link resume-download" href="/shashi-khatri-resume.pdf" download>DOWNLOAD RÉSUMÉ (PDF) <span>↓</span></a></div></div></section>
  <section class="resume-section wrap"><div class="section-heading"><p class="eyebrow">EXPERIENCE</p><span class="mono">PROFESSIONAL HISTORY</span></div>{site.experience.map((item) => <div class="resume-row"><div><span class="mono">{item.dates}</span><h2>{item.title}</h2></div><div><span>{item.website ? <a href={item.website} target="_blank" rel="noreferrer">{item.organization} ↗</a> : item.organization} · {item.location}</span><p>{item.description}</p><ul class="resume-bullets">{item.highlights.map((highlight) => <li>{highlight}</li>)}</ul></div></div>)}</section>
  <section class="resume-section wrap"><div class="section-heading"><p class="eyebrow">SELECTED PROJECTS</p><span class="mono">E-COMMERCE · BACKEND · CUSTOM APPS</span></div>{projects.map((project) => <a class="resume-project" href={`/work/${project.slug}/`}><span class="mono">{project.number}</span><div><h2>{project.title}</h2><p>{project.summary}</p><strong>{project.result}</strong></div><span class="resume-project-arrow">↗</span></a>)}</section>
  <section class="resume-section wrap"><div class="section-heading"><p class="eyebrow">EDUCATION</p><span class="mono">COMPUTER SCIENCE & ENGINEERING</span></div><div class="resume-row"><div><span class="mono">{site.education.dates}</span><h2>{site.education.title}</h2></div><div><span>{site.education.organization} · {site.education.location}</span><p>Relevant coursework: {site.education.coursework}.</p></div></div></section>
  <section class="skills-section"><div class="wrap"><div class="section-heading"><p class="eyebrow">TECHNICAL SKILLS</p><span class="mono">SELECTED TOOLS & PRACTICES</span></div><div class="skills-grid">{site.skills.map((group) => <div><span class="mono">{group.group.toUpperCase()}</span><p>{group.items}</p></div>)}</div></div></section>
</SiteLayout>
